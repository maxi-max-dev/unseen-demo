.pano-page {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  overflow: hidden;
  /* 批次H修:之前写死 #1a0e13,不在任何 token 表里;设计稿 .panorama 用的是
     var(--u-ink),改成跟稿子一致的 token。 */
  background: var(--u-ink);
}
/* 批次I修:补一个显式 z-index(之前是默认 auto)。canvas 用的是新版"节点+
   wx.createSelectorQuery().fields({node:true})"接口(pano.js initGL 里那种)，
   这套接口从基础库2.9.0起支持同层渲染，会正常参与 WXML 的层叠上下文，
   不是老式 canvas-id/wx.createCanvasContext 那种"永远原生层盖在最上面"的
   画布，所以理论上 z-index 已经够用；这里补成显式数值只是让层叠顺序不依赖
   "auto 在没有其他数值时刚好排在下面"这种隐式规则，跟 .pano-top(z-index:10)/
   .gyro-btn(z-index:12)/.photo-rail(z-index:10) 的层级关系写清楚、不留歧义。
   触摸可达性验证方法与结论见 PROGRESS.md 批次I 验收记录。 */
.gl-canvas {
  position: absolute;
  z-index: 0;
  left: 0; top: 0;
  width: 100%;
  height: 100%;
}
/* 贴图加载/首帧渲染前的过渡底色，避免一进页面先看见一块纯黑 */
.pano-wash {
  position: absolute;
  z-index: 1;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(62, 36, 48, 0.30), transparent 26%),
    linear-gradient(0deg, rgba(62, 36, 48, 0.42), transparent 30%);
}

.pano-error {
  position: absolute;
  z-index: 15;
  left: 40rpx;
  right: 40rpx;
  top: 45%;
  padding: 24rpx;
  border-radius: var(--u-r-panel);
  background: rgba(62, 36, 48, 0.82);
  color: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  text-align: center;
}

/* 批次I修:height/margin 原来写死 88rpx/0 24rpx，现在改由 pano.wxml 的
   inline style(navBarHeight/navSideMargin，来自胶囊按钮实测几何)控制，
   这里不再写死，只留其余静态视觉规则(边框/圆角/毛玻璃)。 */
.pano-top {
  position: relative;
  z-index: 10;
  padding: 0 16rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 84rpx;
  align-items: center;
  gap: 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: var(--u-r-panel);
  background: rgba(255, 255, 255, 0.16);
  -webkit-backdrop-filter: blur(var(--u-glass-blur));
  backdrop-filter: blur(var(--u-glass-blur));
}
.round-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}
.pano-title { min-width: 0; text-align: center; }
.pano-title-main {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
}
.pano-title-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.68);
}
.photo-total {
  padding: 0;
  border-radius: var(--u-r-pill);
  color: #fff;
  font-size: 18rpx;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.pano-reticle {
  position: absolute;
  z-index: 6;
  left: 50%;
  top: 44%;
  width: 64rpx;
  height: 64rpx;
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}
.pano-hint {
  position: absolute;
  z-index: 6;
  left: 50%;
  top: calc(44% + 64rpx);
  padding: 10rpx 20rpx;
  border-radius: var(--u-r-pill);
  color: #fff;
  background: rgba(62, 36, 48, 0.5);
  font-size: 20rpx;
  transform: translateX(-50%);
  white-space: nowrap;
  pointer-events: none;
}

.gyro-btn {
  position: absolute;
  z-index: 12;
  right: 32rpx;
  bottom: 260rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  /* 批次H修:这里原来还有 display:flex;align-items:center;justify-content:center,
     跟"原生 button + position:absolute"叠加会导致 width 渲染异常(实测 184px,
     是期望值的3.7倍,height 完全正常;同页面另外两个用 flex 居中的按钮都是
     跟着 grid 走的在流内元素,没有这个问题)。改成让内部 view 自己用绝对定位
     居中,button 本身只负责定位/尺寸/外观,不再当 flex 容器。 */
  border: 1px solid rgba(255, 255, 255, 0.24);
  background: rgba(255, 255, 255, 0.16);
  -webkit-backdrop-filter: blur(var(--u-glass-blur));
  backdrop-filter: blur(var(--u-glass-blur));
}
.gyro-btn--on { background: var(--u-grad); border-color: transparent; }
/* 批次I修:开/关状态之前只有外层按钮底色变化(半透明玻璃→渐变)，图标本身
   (圆环+指针)不管开关都是同一个静止的白色描边，任务要求"开=实心带指针
   动效，关=描边静止，状态一眼可辨"，两档区分不够。默认(关)保留原样——
   描边圆环+静止指针；开启时追加 .gyro-ring--on：圆环从描边变实心白底，
   指针改成品牌粉并配一个轻微来回摆动的动效(不用整圈旋转，整圈转容易让人
   误以为"一直在转圈=卡住了/加载中"，罗盘指针左右探向更像"正在感应方向")。 */
.gyro-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}
.gyro-ring--on {
  background-color: rgba(255, 255, 255, 0.95);
  border-color: rgba(255, 255, 255, 0.95);
}
/* 批次H修:补上设计稿里指针中心的圆点(:before),之前只画了指针(:after),
   缺了圆点会让整个图标看起来像"禁止"符号而不是指南针。 */
.gyro-ring::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--u-pink-hot);
  transform: translate(-50%, -50%);
  transition: background-color 0.2s ease;
}
.gyro-ring--on::after {
  background: var(--u-pink-hot);
  animation: gyroNeedleSense 1.6s ease-in-out infinite;
}
@keyframes gyroNeedleSense {
  0%, 100% { transform: translateX(-50%) rotate(34deg); }
  50% { transform: translateX(-50%) rotate(50deg); }
}
.gyro-ring::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 2rpx;
  width: 2rpx;
  height: 30rpx;
  background: #fff;
  transform: translateX(-50%) rotate(42deg);
}

.photo-rail {
  position: absolute;
  z-index: 10;
  left: 24rpx;
  right: 24rpx;
  bottom: 44rpx;
  padding: 20rpx 20rpx 24rpx;
  border-radius: var(--u-r-panel);
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.14);
  -webkit-backdrop-filter: blur(var(--u-glass-blur));
  backdrop-filter: blur(var(--u-glass-blur));
}
.rail-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 4rpx 16rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.68);
}
.rail-head-b { color: #fff; font-size: 20rpx; font-weight: 650; }
.thumbs { white-space: nowrap; }
.thumb {
  position: relative;
  display: inline-block;
  width: 104rpx;
  height: 96rpx;
  margin-right: 14rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 20rpx;
  background: var(--u-bg-3);
}
.thumb--active { border-color: var(--u-pink-hot); }
.thumb image { width: 100%; height: 100%; display: block; }

/* 批次J新增:上传入口按钮。左下角，bottom:272rpx+height:72rpx 让中心Y
   (272+36=308rpx) 跟 .gyro-btn 的中心Y(bottom:260rpx+96rpx/2=308rpx)对齐，
   对称放在屏幕另一侧——不用跟 .gyro-btn 抢同一块地方，也不碰 .pano-top
   (顶部，返回钮在里面)。 */
.upload-btn {
  position: absolute;
  z-index: 12;
  left: 32rpx;
  bottom: 272rpx;
  height: 72rpx;
  padding: 0 26rpx;
  border-radius: var(--u-r-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(255, 255, 255, 0.24);
  background: rgba(255, 255, 255, 0.16);
  -webkit-backdrop-filter: blur(var(--u-glass-blur));
  backdrop-filter: blur(var(--u-glass-blur));
}
.upload-btn-t {
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

/* 批次J新增:上传状态条。悬在"上传按钮/陀螺仪按钮"那一排(bottom 260~368rpx)
   上方留出的空档里，往上到 .pano-hint/.pano-reticle 之前还有很大一段没被
   任何元素占用，不会跟缩略条(.photo-rail,bottom:44rpx起)或提示文案重叠。 */
.upload-status-bar {
  position: absolute;
  z-index: 13;
  left: 32rpx;
  right: 32rpx;
  bottom: 376rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--u-r-pill);
  background: rgba(62, 36, 48, 0.72);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
  -webkit-backdrop-filter: blur(var(--u-glass-blur));
  backdrop-filter: blur(var(--u-glass-blur));
}
