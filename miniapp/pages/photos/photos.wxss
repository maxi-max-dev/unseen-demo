.photos-page {
  min-height: 100%;
  background:
    radial-gradient(circle at 82% 3%, var(--u-card), transparent 30%),
    linear-gradient(155deg, var(--u-bg-1), var(--u-bg-2) 54%, var(--u-bg-3));
}

/* 批次I修:padding 挪给 native-nav(inline，来自胶囊几何) + position-heading
   (静态，数值不变，见下方注释)各自负责，position-top 自己不再统一给横向内边距。 */
.position-top { }
.native-nav {
  display: grid;
  grid-template-columns: 64rpx 1fr 64rpx;
  align-items: center;
}
.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--u-ink-2);
  font-size: 44rpx;
  font-weight: 300;
}
.nav-title { font-size: 28rpx; text-align: center; color: var(--u-ink); }
.nav-spacer { width: 64rpx; }

/* 批次I修:水平内边距从 4rpx 改成 36rpx——之前视觉上的实际间距=父级
   position-top 的 32rpx padding + 这里自己的 4rpx=36rpx，现在 position-top
   不再统一给横向 padding(那份 32rpx 挪给了 native-nav 走胶囊实测值)，
   这里补成 36rpx 直接持平，标题区视觉间距跟批次H验收时完全一样，不是新的
   设计决定。 */
.position-heading { padding: 20rpx 36rpx 30rpx; }
.eyebrow {
  display: block;
  margin: 0 0 14rpx;
  color: var(--u-pink-hot);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 0.2em;
}
.heading-title {
  display: block;
  /* 批次H修:52rpx 按750rpx设计宽换算等价稿子26.4px,稿子实际是30px(比值0.90,
     同页eyebrow/heading-sub换算比值都在0.99~1.04),改成58rpx对齐。 */
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--u-ink);
}
.heading-sub {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--u-ink-3);
}
.heading-sub .num { color: var(--u-ink-2); font-weight: 650; }
.dot-sep { margin: 0 6rpx; }

.empty-card {
  margin: 20rpx 32rpx;
  padding: 40rpx 32rpx;
  border-radius: var(--u-r-panel);
  border: 1px solid var(--u-line);
  background: var(--u-card);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.empty-text { font-size: 25rpx; color: var(--u-ink-2); line-height: 1.6; }
.retry-btn {
  padding: 14rpx 32rpx;
  border-radius: var(--u-r-pill);
  background: var(--u-grad);
  color: var(--u-card);
  font-size: 24rpx;
  font-weight: 600;
}

.photo-list {
  position: relative;
  padding: 0 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.photo-card {
  min-height: 210rpx;
  padding: 16rpx;
  display: grid;
  grid-template-columns: 200rpx minmax(0, 1fr);
  gap: 20rpx;
  border: 1px solid var(--u-line);
  border-radius: var(--u-r-panel);
  background: var(--u-card);
  box-shadow: var(--u-shadow);
}
.card-figure {
  position: relative;
  min-width: 0;
  height: 178rpx;
  border-radius: var(--u-r-card);
  overflow: hidden;
  background: var(--u-bg-3);
}
.card-figure image { width: 100%; height: 100%; display: block; }
.bearing-dot {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--u-pink-hot);
  background: var(--u-glass);
  -webkit-backdrop-filter: blur(var(--u-glass-blur));
  backdrop-filter: blur(var(--u-glass-blur));
  font-size: 22rpx;
  font-weight: 700;
}
.card-copy {
  min-width: 0;
  padding: 10rpx 6rpx 8rpx 0;
  display: flex;
  flex-direction: column;
}
.photo-index {
  color: var(--u-ink-3);
  font-size: 18rpx;
  font-weight: 650;
  letter-spacing: 0.14em;
}
.card-title {
  margin-top: 16rpx;
  /* 批次H修:27rpx换算等价稿子14.04px,稿子实际是16px(比值0.88),改成31rpx对齐。 */
  font-size: 31rpx;
  line-height: 1.35;
  color: var(--u-ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-meta {
  margin-top: auto;
  padding-top: 12rpx;
  font-size: 21rpx;
  color: var(--u-ink-2);
}
.meta-dir { color: var(--u-pink-hot); font-weight: 650; font-variant-numeric: tabular-nums; }

.list-foot {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--u-ink-3);
  text-align: center;
}

/* 批次J新增:我传的照片区。只用 app.wxss 里已经声明过的 token，没有引用
   miniapp 没搬过来的 --u-glass-soft/--u-wash-pink 之类的 web 端变量。 */
.mine-section {
  margin: 20rpx 32rpx 4rpx;
  padding: 20rpx 20rpx 8rpx;
  border: 1px dashed var(--u-line);
  border-radius: var(--u-r-panel);
  background: var(--u-glass);
}
.mine-head {
  display: block;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--u-ink-3);
}
.mine-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0 14rpx;
}
.mine-row + .mine-row { border-top: 1px solid var(--u-line); }
.mine-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: var(--u-bg-3);
  flex: none;
}
.mine-meta { min-width: 0; }
.mine-tag {
  display: inline-block;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--u-pink-hot);
  background: rgba(255, 92, 138, 0.14);
  border-radius: var(--u-r-pill);
  padding: 2rpx 10rpx;
  margin-right: 8rpx;
}
.mine-status { font-size: 21rpx; color: var(--u-ink-2); }

/* 批次K：「我传的」补两样——重传入口和后端给的人话备注。 */
.mine-head-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.mine-retry {
  font-size: 24rpx;
  color: #C2185B;
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(194, 24, 91, 0.35);
  border-radius: 999rpx;
}
.mine-note {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(62, 36, 48, 0.55);
}
