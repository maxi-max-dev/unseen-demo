.photos-page {
  min-height: 100%;
  background:
    radial-gradient(circle at 82% 3%, var(--u-card), transparent 30%),
    linear-gradient(155deg, var(--u-bg-1), var(--u-bg-2) 54%, var(--u-bg-3));
}

.position-top { padding: 0 32rpx; }
.native-nav {
  min-height: 84rpx;
  display: grid;
  grid-template-columns: 64rpx 1fr 64rpx;
  align-items: center;
}
.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--u-ink-2);
  font-size: 44rpx;
  font-weight: 300;
}
.nav-title { font-size: 28rpx; text-align: center; color: var(--u-ink); }
.nav-spacer { width: 64rpx; }

.position-heading { padding: 20rpx 4rpx 30rpx; }
.eyebrow {
  display: block;
  margin: 0 0 14rpx;
  color: var(--u-pink-hot);
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 0.2em;
}
.heading-title {
  display: block;
  /* 批次H修:52rpx 按750rpx设计宽换算等价稿子26.4px,稿子实际是30px(比值0.90,
     同页eyebrow/heading-sub换算比值都在0.99~1.04),改成58rpx对齐。 */
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--u-ink);
}
.heading-sub {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--u-ink-3);
}
.heading-sub .num { color: var(--u-ink-2); font-weight: 650; }
.dot-sep { margin: 0 6rpx; }

.empty-card {
  margin: 20rpx 32rpx;
  padding: 40rpx 32rpx;
  border-radius: var(--u-r-panel);
  border: 1px solid var(--u-line);
  background: var(--u-card);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.empty-text { font-size: 25rpx; color: var(--u-ink-2); line-height: 1.6; }
.retry-btn {
  padding: 14rpx 32rpx;
  border-radius: var(--u-r-pill);
  background: var(--u-grad);
  color: var(--u-card);
  font-size: 24rpx;
  font-weight: 600;
}

.photo-list {
  position: relative;
  padding: 0 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.photo-card {
  min-height: 210rpx;
  padding: 16rpx;
  display: grid;
  grid-template-columns: 200rpx minmax(0, 1fr);
  gap: 20rpx;
  border: 1px solid var(--u-line);
  border-radius: var(--u-r-panel);
  background: var(--u-card);
  box-shadow: var(--u-shadow);
}
.card-figure {
  position: relative;
  min-width: 0;
  height: 178rpx;
  border-radius: var(--u-r-card);
  overflow: hidden;
  background: var(--u-bg-3);
}
.card-figure image { width: 100%; height: 100%; display: block; }
.bearing-dot {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--u-pink-hot);
  background: var(--u-glass);
  -webkit-backdrop-filter: blur(var(--u-glass-blur));
  backdrop-filter: blur(var(--u-glass-blur));
  font-size: 22rpx;
  font-weight: 700;
}
.card-copy {
  min-width: 0;
  padding: 10rpx 6rpx 8rpx 0;
  display: flex;
  flex-direction: column;
}
.photo-index {
  color: var(--u-ink-3);
  font-size: 18rpx;
  font-weight: 650;
  letter-spacing: 0.14em;
}
.card-title {
  margin-top: 16rpx;
  /* 批次H修:27rpx换算等价稿子14.04px,稿子实际是16px(比值0.88),改成31rpx对齐。 */
  font-size: 31rpx;
  line-height: 1.35;
  color: var(--u-ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-meta {
  margin-top: auto;
  padding-top: 12rpx;
  font-size: 21rpx;
  color: var(--u-ink-2);
}
.meta-dir { color: var(--u-pink-hot); font-weight: 650; font-variant-numeric: tabular-nums; }

.list-foot {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--u-ink-3);
  text-align: center;
}
