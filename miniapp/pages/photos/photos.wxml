<!-- 03 · 照片方位屏：卡片列表，点卡片跳回 pano 页并转到对应方位。 -->
<view class="photos-page">
  <!-- 批次I修:padding-top 原来只用 statusBarHeight(连批次H给pano补的+12都没有)，
       改成 navBarTop；native-nav 的水平内边距原来靠父级 position-top 的 32rpx
       padding 顺带给，现在改成自己按 navSideMargin(胶囊右边距实测值)算，
       跟 pano 页返回钮同一套逻辑对齐胶囊；position-heading 的视觉间距不变
       (见下方它自己的 padding，从"父级32rpx+自己4rpx"合并成自己的36rpx，
       数值上完全等价，不是新的设计决定)。 -->
  <view class="position-top" style="padding-top:{{navBarTop}}px">
    <view class="native-nav" style="height:{{navBarHeight}}px;margin:0 {{navSideMargin}}px">
      <button class="back-btn" bindtap="onBack" aria-label="返回">‹</button>
      <text class="nav-title">照片方位</text>
      <view class="nav-spacer"></view>
    </view>
    <view class="position-heading">
      <text class="eyebrow">{{spaceTitle}} · WEDDING MEMORY</text>
      <text class="heading-title">散落的视角</text>
      <view class="heading-sub" wx:if="{{!loading && !loadError}}">
        <text>{{spaceCouple}}</text>
        <text class="dot-sep">·</text>
        <text class="num">{{photos.length}}</text>
        <text> 张照片</text>
        <text class="dot-sep">·</text>
        <text class="num">{{contributorCount}}</text>
        <text> 位贡献者</text>
      </view>
    </view>
  </view>

  <!-- 批次J新增:我传的照片区。读的是本地这次会话的上传记录(utils/upload.js
       的 myUploads)，不依赖下面 photo-list 那次网络请求成不成功，所以放在
       loading/error 判断之外——网慢的时候也能看到自己刚传的这几张在什么状态。
       只加这一块，.position-top/.native-nav(返回钮/导航布局)一个字没动。 -->
  <view class="mine-section" wx:if="{{myUploads.length}}">
    <view class="mine-head-row">
      <text class="mine-head">我传的</text>
      <!-- 批次K:待重传队列。失败照片的压缩副本被存成了持久文件，杀进程重开还能按。 -->
      <text class="mine-retry" wx:if="{{retryCount}}" bindtap="onRetryUploads">重传 {{retryCount}} 张</text>
    </view>
    <view class="mine-row" wx:for="{{myUploads}}" wx:key="key">
      <image wx:if="{{item.thumb}}" class="mine-thumb" src="{{item.thumb}}" mode="aspectFill" />
      <view wx:else class="mine-thumb mine-thumb--placeholder"></view>
      <view class="mine-meta">
        <text class="mine-tag">我传的</text>
        <text class="mine-status">{{item.statusText}}</text>
        <!-- 后端在 pending 回执里给的人话(publish.py)，有就照实显示，不自己编原因 -->
        <text class="mine-note" wx:if="{{item.note}}">{{item.note}}</text>
      </view>
    </view>
  </view>

  <block wx:if="{{loading}}">
    <view class="empty-card"><text>照片正在路上…</text></view>
  </block>

  <block wx:elif="{{loadError}}">
    <view class="empty-card">
      <text class="empty-text">照片列表暂时读不到，可能是网络问题。</text>
      <button class="retry-btn" bindtap="onRetry">重新加载</button>
    </view>
  </block>

  <block wx:else>
    <view class="photo-list">
      <view
        wx:for="{{photos}}"
        wx:key="id"
        class="photo-card"
        data-yaw="{{item.yaw}}"
        bindtap="onTapCard"
      >
        <view class="card-figure">
          <image src="{{item.thumb || item.src}}" mode="aspectFill" />
          <view class="bearing-dot">{{item.arrow}}</view>
        </view>
        <view class="card-copy">
          <text class="photo-index">方位 {{item.indexLabel}}</text>
          <text class="card-title">{{item.line}}</text>
          <text class="card-meta">{{item.contributor}}上传 · <text class="meta-dir">{{item.dirLabel}}</text></text>
        </view>
      </view>
      <text class="list-foot">每一张照片，都留在它当时朝向的空间里。</text>
    </view>
  </block>
</view>
